ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.09-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsndfile1 \
        ninja-build \
        pkg-config \
        swig \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.gpt-sovits-tts.txt /tmp/requirements.gpt-sovits-tts.txt
COPY requirements.txt /tmp/requirements.voice-service.txt

# The NGC image already contains the matching CUDA build of torch/torchaudio.
# Do not replace them with wheels from PyPI.
RUN unset PIP_CONSTRAINT \
    && python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements.gpt-sovits-tts.txt \
    && python -m pip install -r /tmp/requirements.voice-service.txt \
    && ln -sf "$(command -v python)" /usr/local/bin/desk-voice-python

WORKDIR /srv/voice

EXPOSE 8001

CMD ["/usr/local/bin/desk-voice-python", "app/main.py", "--host", "0.0.0.0", "--port", "8001"]

